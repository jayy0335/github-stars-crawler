# Required: GitHub API token
GITHUB_TOKEN=your_personal_access_token_here

# PostgreSQL connection (defaults match your code)
PGHOST=postgres
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=postgres

# Application settings
TARGET_COUNT=100000
DAYS_PER_SLICE=3
BATCH_SIZE=1000

# Output file path
OUT_CSV=artifacts/repos_stars.csv
